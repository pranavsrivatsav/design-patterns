{
  "compilerOptions": {
    "target": "es2021",
    "module": "node16",
    "moduleResolution": "node16",
    "resolvePackageJsonExports": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "*/src/**/*.ts",
    "*/src/**/*.tsx",
    "*/src/**/*.d.ts"
  ]
}
